)
gam_pa_pv_time_pvxtime <- bam(
suitability_beta ~
s(PA_s) +
s(PV_s) +
s(dekad_c, bs="cc", k=12) +
ti(PV_s, dekad_c,
bs=c("tp","cc"),
k=c(10,12)),
family = betar(link="logit"),
data = tbl_model,
method = "fREML",
discrete = TRUE
)
# PA×PV + PA×TIME
gam_paxpv_paxtime <- bam(
suitability_beta ~
s(PA_s) +
s(PV_s) +
s(dekad_c, bs="cc", k=12) +
ti(PA_s, PV_s) +
ti(PA_s, dekad_c,
bs=c("tp","cc"),
k=c(10,12)),
family = betar(link="logit"),
data = tbl_model,
method = "fREML",
discrete = TRUE
)
# PA×PV + PV×TIME
gam_paxpv_pvxtime <- bam(
suitability_beta ~
s(PA_s) +
s(PV_s) +
s(dekad_c, bs="cc", k=12) +
ti(PA_s, PV_s) +
ti(PV_s, dekad_c,
bs=c("tp","cc"),
k=c(10,12)),
family = betar(link="logit"),
data = tbl_model,
method = "fREML",
discrete = TRUE
)
# PA×TIME + PV×TIME
gam_pa_pv_time_paxtime_pvxtime <- bam(
suitability_beta ~
s(PA_s) +
s(PV_s) +
s(dekad_c, bs="cc", k=12) +
ti(PA_s, dekad_c,
bs=c("tp","cc"),
k=c(10,12)) +
ti(PV_s, dekad_c,
bs=c("tp","cc"),
k=c(10,12)),
family = betar(link="logit"),
data = tbl_model,
method = "fREML",
discrete = TRUE
)
# MODELO COMPLETO
gam_full <- bam(
suitability_beta ~
s(PA_s) +
s(PV_s) +
s(dekad_c, bs="cc", k=12) +
ti(PA_s, PV_s) +
ti(PA_s, dekad_c,
bs=c("tp","cc"),
k=c(10,12)) +
ti(PV_s, dekad_c,
bs=c("tp","cc"),
k=c(10,12)),
family = betar(link="logit"),
data = tbl_model,
method = "fREML",
discrete = TRUE
)
# --------------------------------------------------------
# MODEL TABLE
# --------------------------------------------------------
model_tbl <- data.frame(
Model = c(
"GLM_PA",
"GLM_PV",
"GLM_PA_PV",
"GAM_PA",
"GAM_PV",
"GAM_PA_PV",
"GAM_PA_TIME",
"GAM_PV_TIME",
"GAM_PA_PV_TIME",
"GAM_PAxPV",
"GAM_PAxTIME",
"GAM_PVxTIME",
"GAM_PA_PV_TIMExPA",
"GAM_PA_PV_TIMExPV",
"GAM_PAxPV_PAxTIME",
"GAM_PAxPV_PVxTIME",
"GAM_PAxTIME_PVxTIME",
"GAM_FULL"
),
AIC = c(
AIC(glm_pa),
AIC(glm_pv),
AIC(glm_both),
AIC(gam_pa),
AIC(gam_pv),
AIC(gam_pa_pv),
AIC(gam_pa_time),
AIC(gam_pv_time),
AIC(gam_pa_pv_time),
AIC(gam_paxpv),
AIC(gam_paxtime),
AIC(gam_pvxtime),
AIC(gam_pa_pv_time_paxtime),
AIC(gam_pa_pv_time_pvxtime),
AIC(gam_paxpv_paxtime),
AIC(gam_paxpv_pvxtime),
AIC(gam_pa_pv_time_paxtime_pvxtime),
AIC(gam_full)
),
Deviance_Explained = c(
1-glm_pa$deviance/glm_pa$null.deviance,
1-glm_pv$deviance/glm_pv$null.deviance,
1-glm_both$deviance/glm_both$null.deviance,
summary(gam_pa)$dev.expl,
summary(gam_pv)$dev.expl,
summary(gam_pa_pv)$dev.expl,
summary(gam_pa_time)$dev.expl,
summary(gam_pv_time)$dev.expl,
summary(gam_pa_pv_time)$dev.expl,
summary(gam_paxpv)$dev.expl,
summary(gam_paxtime)$dev.expl,
summary(gam_pvxtime)$dev.expl,
summary(gam_pa_pv_time_paxtime)$dev.expl,
summary(gam_pa_pv_time_pvxtime)$dev.expl,
summary(gam_paxpv_paxtime)$dev.expl,
summary(gam_paxpv_pvxtime)$dev.expl,
summary(gam_pa_pv_time_paxtime_pvxtime)$dev.expl,
summary(gam_full)$dev.expl
)
)
model_tbl <- model_tbl[order(model_tbl$AIC), ]
model_tbl$Delta_AIC <- model_tbl$AIC - min(model_tbl$AIC)
model_tbl$Rank <- seq_len(nrow(model_tbl))
# --------------------------------------------------------
# EXCEL
# --------------------------------------------------------
wb <- createWorkbook()
addWorksheet(wb, "Summary")
writeData(wb, "Summary", summary_tbl)
addWorksheet(wb, "Correlation")
writeData(wb, "Correlation", cor_tbl)
addWorksheet(wb, "Models")
writeData(wb, "Models", model_tbl)
saveWorkbook(
wb,
file.path(
out_dir,
paste0(
sp,
"_ExplorationV.2.xlsx"
)
),
overwrite = TRUE
)
cat(
"\nFINAL EXPLORATION COMPLETED\n"
)
print(p)
#=========================================
# FIGURA - PSEUDOAUSENCIAS
#=========================================
library(sf)
library(tidyverse)
library(mapSpain)
library(rnaturalearth)
library(ggplot2)
rm(list = ls())
gc()
#-----------------------------------------
# MÁSCARA PENÍNSULA IBÉRICA
#-----------------------------------------
provinces <- esp_get_prov()
provinces <- provinces[
!provinces$iso2.prov.name.es %in%
c("Las Palmas",
"Santa Cruz de Tenerife",
"Baleares",
"Ceuta",
"Melilla"),
]
mask_spain <- st_union(provinces)
por <- ne_countries(
country = "Portugal",
scale = "medium",
returnclass = "sf"
)
por_polys <- st_cast(por, "POLYGON")
por_polys$area <- st_area(por_polys)
por_cont <- por_polys |>
slice_max(area, n = 1)
por_cont <- st_transform(
por_cont,
st_crs(mask_spain)
)
iberia_mask <- st_union(
mask_spain,
por_cont
)
iberia_mask <- st_transform(
iberia_mask,
25830)
#-----------------------------------------
# LEER DATOS
#-----------------------------------------
ruta <- "E:/TFM_gangas/GPS/MergedV.2/"
leer <- function(file, especie, metodo){
read_csv(file, show_col_types = FALSE) |>
filter(presence == 0) |>
mutate(
Especie = especie,
Método = metodo
)
}
datos <- bind_rows(
leer(
paste0(ruta,"BBS_pseudoabsences_Random.csv"),
"Pterocles alchata",
"Random"
),
leer(
paste0(ruta,"PTS_pseudoabsences_Random.csv"),
"Pterocles orientalis",
"Random"
),
leer(
paste0(ruta,"BBS_pseudoabsences_P95_decay.csv"),
"Pterocles alchata",
"P95"
),
leer(
paste0(ruta,"PTS_pseudoabsences_P95_decay.csv"),
"Pterocles orientalis",
"P95"
),
leer(
paste0(ruta,"BBS_pseudoabsences_MCP40_decay.csv"),
"Pterocles alchata",
"MCP40km"
),
leer(
paste0(ruta,"PTS_pseudoabsences_MCP40_decay.csv"),
"Pterocles orientalis",
"MCP40km"
)
)
#-----------------------------------------
# CONVERTIR A sf
#-----------------------------------------
datos_sf <- st_as_sf(
datos,
coords = c("X_25830","Y_25830"),
crs = 25830
)
#-----------------------------------------
# ORDEN DE LOS FACETS
#-----------------------------------------
datos_sf$Método <- factor(
datos_sf$Método,
levels = c(
"Random",
"P95",
"MCP40km"
)
)
datos_sf$Especie <- factor(
datos_sf$Especie,
levels = c(
"Pterocles alchata",
"Pterocles orientalis"
)
)
#-----------------------------------------
# ETIQUETAS EN CURSIVA PARA LAS ESPECIES
#-----------------------------------------
lab_especies <- as_labeller(c(
"Pterocles alchata" = "Pterocles alchata",
"Pterocles orientalis" = "Pterocles orientalis"
))
#-----------------------------------------
# FIGURA
#-----------------------------------------
p <- ggplot() +
geom_sf(
data = iberia_mask,
fill = "grey94",
colour = "grey55",
linewidth = 0.25
) +
geom_sf(
data = subset(datos_sf, Especie == "Pterocles alchata"),
colour = "#3B6FB6",
size = 0.12,
alpha = 0.65
) +
geom_sf(
data = subset(datos_sf, Especie == "Pterocles orientalis"),
colour = "#D95F02",
size = 0.12,
alpha = 0.65
) +
facet_grid(
Método ~ Especie,
labeller = labeller(
Especie = label_value
)
) +
coord_sf(expand = FALSE) +
theme_void() +
theme(
strip.background = element_rect(
fill = "grey90",
colour = "grey60"
),
strip.text.y = element_text(
face = "bold",
size = 12
),
strip.text.x = element_text(
face = "italic",
size = 12
),
panel.spacing = unit(0.5, "lines")
)
print(p)

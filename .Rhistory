for(yr in unique(pop_use_year)){
idx <- which(pop_use_year == yr)
r   <- pop_stack[[which(pop_years == yr)]]
pts$Population[idx] <- terra::extract(r, pts_vect[idx,])[,2]
}
toc()
# ==========================================================

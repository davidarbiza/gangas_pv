# PROCESS CLC FINAL RECLASS
# -----------------------
cat("Reclassifying CLC raster...\n")
# Load the cropped raster
r_crop <- rast(intermediate_file)
# Reproject to EPSG:25830 using nearest neighbor
r_proj <- project(r_crop, "EPSG:25830", method="near")
# Reclassify raster
r_reclass <- classify(r_proj, clc_matrix, others=999)
# Assign class labels
levels(r_reclass) <- class_table
# Save final raster
out_name <- paste0(base_folder, "CLC2018_PB_Reclass.tif")
writeRaster(r_reclass, out_name, overwrite=TRUE)
rm(r, r_crop, r_proj, r_reclass, mask, mask_proj); gc()
cat("CLC2018 reclassified raster saved:", out_name, "\n")
cat("CLC2018 processing completed successfully!\n")
################################
# CLC2018 RECLASSIFICATION SCRIPT
################################
library(terra)
library(sf)
# -----------------------
# PATHS
# -----------------------
base_folder <- "E:/TFM_gangas/LULUCF/CLC2018/"
clc_file <- "U2018_CLC2018_V2020_20u1.tif"
# -----------------------
# MASK BBOX (Peninsula)
# -----------------------
peninsula_bbox <- st_bbox(c(xmin = -10, ymin = 35.5, xmax = 5, ymax = 44.5), crs = 4326)
mask <- vect(st_as_sfc(peninsula_bbox))
# -----------------------
# CROP AND REPROJECT TO EPSG:25830
# -----------------------
cat("Cropping and reprojecting CLC raster to EPSG:25830...\n")
r <- rast(paste0(base_folder, clc_file))
# Reproject mask to raster CRS
mask_proj <- project(mask, crs(r))
# Crop raster to mask
r_crop <- crop(r, mask_proj)
# Reproject cropped raster to EPSG:25830 using nearest neighbor
r_25830 <- project(r_crop, "EPSG:25830", method="near")
# Save intermediate raster
intermediate_file <- paste0(base_folder, "CLC2018_PB.tif")
writeRaster(r_25830, intermediate_file, overwrite=TRUE)
cat("Intermediate raster saved:", intermediate_file, "\n")
# -----------------------
# FINAL CLASS VALUES
# -----------------------
classes <- c(
"Bosques" = 1,
"Olivares" = 2,
"Viñedos" = 3,
"Otros cultivos perennes" = 4,
"Arrozales" = 5,
"Invernaderos" = 6,
"Cultivos anuales de secano" = 7,
"Pastizales con árboles" = 8,
"Pastizales arbustivos" = 9,
"Pastizales herbáceos" = 10,
"Zonas acuáticas" = 11,
"Marismas" = 12,
"Áreas artificiales" = 13,
"Otras tierras" = 14,
"Mosaico de cultivos complejos" = 15,
"Cultivos anuales de regadío" = 16,
"NODATA" = 999
)
class_table <- data.frame(value = unname(classes), class = names(classes))
# -----------------------
# CLC RECLASS MATRIX
# -----------------------
clc_matrix <- matrix(c(
# Áreas artificiales
111,13, 112,13, 121,13, 122,13, 123,13, 124,13, 131,13, 132,13, 133,13, 141,13, 142,13,
# Cultivos anuales / regadío / arrozales / invernaderos
211,7, 212,16, 213,5, 221,3, 222,4, 223,2,
# Pastizales
231,10, 241,15, 242,15, 243,15, 244,15, 321,10, 322,9, 323,10, 324,8,
# Bosques
311,1, 312,1, 313,1,
# Otras tierras
331,14, 332,14, 333,14, 334,14, 335,14,
# Superficies de agua
411,11, 412,11, 421,12, 422,11, 423,11, 511,11, 512,11, 521,11, 522,11, 523,11,
# NODATA
999,999
), ncol=2, byrow=TRUE)
# -----------------------
# PROCESS CLC FINAL RECLASS
# -----------------------
cat("Reclassifying CLC raster...\n")
# Load the intermediate raster (already in EPSG:25830)
r_final <- rast(intermediate_file)
# Reclassify raster
r_reclass <- classify(r_final, clc_matrix, others=999)
# Assign class labels
levels(r_reclass) <- class_table
# Save final raster
out_name <- paste0(base_folder, "CLC2018_PB_Reclass.tif")
writeRaster(r_reclass, out_name, overwrite=TRUE)
rm(r, r_crop, r_25830, r_final, r_reclass, mask, mask_proj); gc()
cat("CLC2018 reclassified raster saved:", out_name, "\n")
cat("CLC2018 processing completed successfully!\n")

fun = function(x){
pred <- predict(
gam_model,
newdata = data.frame(predicted = x),
type = "response"
)
return(pred)
}
)
# ------------------------------------------------------
# OUTPUT NAME
# ------------------------------------------------------
out_name <- str_replace(
basename(f),
"_ENSEMBLE.tif",
"_CALIBRATED.tif"
)
# ------------------------------------------------------
# SAVE
# ------------------------------------------------------
writeRaster(
calibrated_r,
file.path(out_dir, out_name),
overwrite = TRUE
)
rm(r, calibrated_r)
gc()
}
}
}

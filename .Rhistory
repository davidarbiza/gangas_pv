library(terra)
library(openxlsx)
base_folder <- "E:/TFM_gangas/LULUCF/"
files <- list(
LULUCF2015 = paste0(base_folder, "LULUCF2015_PB_Reclass.tif"),
LULUCF2018 = paste0(base_folder, "LULUCF2018_PB_Reclass.tif"),
LULUCF2021 = paste0(base_folder, "LULUCF2021_PB_Reclass.tif"),
COS2023    = paste0(base_folder, "COS2023v1-S2_Reclass.tif"),
CLC2018    = paste0(base_folder, "CLC2018/CLC2018_PB_Reclass.tif")
)
class_names <- c(
"1"="Bosques",
"2"="Olivares",
"3"="Viñedos",
"4"="Otros cultivos perennes",
"5"="Arrozales",
"6"="Invernaderos",
"7"="Cultivos anuales de secano",
"8"="Pastizales con árboles",
"9"="Pastizales arbustivos",
"10"="Pastizales herbáceos",
"11"="Zonas acuáticas",
"12"="Marismas",
"13"="Áreas artificiales",
"14"="Otras tierras",
"15"="Mosaico de cultivos complejos",
"16"="Cultivos anuales de regadío",
"999"="NODATA"
)
wb <- createWorkbook()
for (name in names(files)) {
cat("Processing", name, "\n")
r <- rast(files[[name]])
f <- as.data.frame(freq(r))
f <- f[!is.na(f$value), ]
f$class_name <- class_names[as.character(f$value)]
addWorksheet(wb, name)
# -----------------------------
# TABLE 1 — INCLUDING NODATA
# -----------------------------
total_cells_all <- sum(f$count)
f_all <- f
f_all$percentage <- round((f_all$count / total_cells_all) * 100, 2)
f_all <- f_all[order(as.numeric(f_all$value)), c("value","class_name","count","percentage")]
names(f_all) <- c("Class value","Class name","Cell count","Percentage (%)")
writeData(wb, name, "Percentages INCLUDING NODATA", startRow=1, startCol=1)
writeData(wb, name, f_all, startRow=2, startCol=1)
# -----------------------------
# TABLE 2 — EXCLUDING NODATA (only for CLC)
# -----------------------------
if (name == "CLC2018") {
f_noNA <- f[f$value != 999, ]
total_cells_noNA <- sum(f_noNA$count)
f_noNA$percentage <- round((f_noNA$count / total_cells_noNA) * 100, 2)
f_noNA <- f_noNA[order(as.numeric(f_noNA$value)), c("value","class_name","count","percentage")]
names(f_noNA) <- c("Class value","Class name","Cell count","Percentage (%)")
start_row_2 <- nrow(f_all) + 5
writeData(wb, name, "Percentages EXCLUDING NODATA", startRow=start_row_2, startCol=1)
writeData(wb, name, f_noNA, startRow=start_row_2 + 1, startCol=1)
}
}
saveWorkbook(wb, paste0(base_folder, "Class_percentage.xlsx"), overwrite=TRUE)
cat("Excel saved in:", paste0(base_folder, "Class_percentage.xlsx"), "\n")
